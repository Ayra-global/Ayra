# ─── Frontend (Vite) ─── expuestas al navegador: NUNCA poner secretos con prefijo VITE_
VITE_API_URL=http://localhost:3000

# ─── Vercel Function /api/send-email ─── (solo servidor; configurarlas en Vercel → Settings → Environment Variables)
# OJO: Vercel reserva los nombres AWS_*, por eso usamos prefijo SES_
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Email verificado en SES (en sandbox, el destinatario también debe estar verificado)
SES_FROM_EMAIL=AYRA Wallet <no-reply@tu-dominio.com>
# Mismo valor que INTERNAL_API_SECRET del backend
INTERNAL_API_SECRET=
